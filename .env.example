# ---------------------------------------------------------------- Supabase
# These NEXT_PUBLIC_ values are compiled into the public browser bundle by design.
# (The old VITE_ names still work as a fallback.)
# The publishable key is safe to expose; never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-supabase-key

# Create a public bucket with this name for blog featured images.
NEXT_PUBLIC_SUPABASE_BLOG_IMAGES_BUCKET=your-public-blog-images-bucket

# ---------------------------------------------------------------- AdSense
# Ad unit slot IDs from the AdSense dashboard (Ads > By ad unit > Display ads).
# Leave these unset until real units exist: AdSlot renders nothing without an
# ID, and an empty ad container on a live page is an AdSense policy problem.
#
#   toolInline    – below the tool interface on a /tools/<slug> page
#   toolFooter    – in the sidebar beneath the related-tools list
#   articleInline – at the end of a blog article body
#   listing       – between category blocks on the /tools directory
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_FOOTER=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_LISTING=
